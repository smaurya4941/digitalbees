APP_NAME=TeamBees
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 — the infrastructure/docker-compose.yml service publishes 3307.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=digitalbees_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@teambees.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend / headless integration ──────────────────────────────────────
# Browser origin(s) allowed by CORS (comma-separated).
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
# Optional regex for preview/branch deploys, e.g. "#^https://.*\.teambees\.com$#"
FRONTEND_URL_PATTERN=

# On-demand ISR: Laravel calls {FRONTEND_URL}/api/revalidate with this secret
# when content is published/updated. Must match the frontend's REVALIDATE_SECRET.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# ── Search ──────────────────────────────────────────────────────────────
SEARCH_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ── CRM ─────────────────────────────────────────────────────────────────
CRM_DRIVER=log
CRM_API_BASE_URL=
CRM_API_KEY=
